  function getMaskCoords(e){
    var rect = displayCanvas.getBoundingClientRect();
    var dx = (e.clientX - rect.left) * (displayCanvas.width / rect.width);
    var dy = (e.clientY - rect.top) * (displayCanvas.height / rect.height);
    var mx = dx * (state.refW / state.W);
    var my = dy * (state.refH / state.H);
    return { mx: mx, my: my, dx: dx, dy: dy };
  }

  var isDrawing = false;
  var lastX = 0, lastY = 0;

  function drawBrush(x1, y1, x2, y2){
    var ctx = state.maskCtx;
    var scale = state.refW / state.W;
    var brushW = state.brushSize * scale;
    var r = brushW / 2;
    ctx.save();
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.lineWidth = brushW;
    if(state.drawMode === 'draw'){
      ctx.strokeStyle = 'rgba(255,255,255,1)';
      ctx.fillStyle = 'rgba(255,255,255,1)';
      ctx.globalCompositeOperation = 'source-over';
    } else {
      ctx.strokeStyle = 'rgba(0,0,0,1)';
      ctx.fillStyle = 'rgba(0,0,0,1)';
      ctx.globalCompositeOperation = 'destination-out';
    }
    if(x1 !== x2 || y1 !== y2){
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    }
    ctx.beginPath();
    ctx.arc(x2, y2, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
    renderDisplay();
  }

  displayCanvas.addEventListener('pointerdown', function(e){
    e.preventDefault();
    if(state.toolMode === 'polygon'){
      var c = getMaskCoords(e);
      state.polygonPoints.push({ x: c.dx, y: c.dy, mx: c.mx, my: c.my });
      renderDisplay();
      updatePolygonActions();
      return;
    }
    pushHistory();
    isDrawing = true;
    try { displayCanvas.setPointerCapture(e.pointerId); } catch(err){}
    var coords = getMaskCoords(e);
    lastX = coords.mx;
    lastY = coords.my;
    drawBrush(coords.mx, coords.my, coords.mx, coords.my);
  });

  displayCanvas.addEventListener('pointermove', function(e){
    if(!isDrawing || state.toolMode !== 'free') return;
    e.preventDefault();
    var c = getMaskCoords(e);
    drawBrush(lastX, lastY, c.mx, c.my);
    lastX = c.mx;
    lastY = c.my;
  });

