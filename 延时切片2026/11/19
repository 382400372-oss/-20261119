<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };

  var state = {
    videoFiles: [],
    previewIndex: 0,
    duration: 0,
    W: 0,
    H: 0,
    refW: null,
    refH: null,
    maskCanvas: null,
    maskCtx: null,
    tempCanvas: null,
    tempCtx: null,
    dctx: null,
    brushSize: 60,
    toolMode: 'free',
    drawMode: 'draw',
    polygonPoints: [],
    history: [],
    MAX_HISTORY: 15,
    bgColor: '#000000',
    transparentBg: false,
    smartCrop: false,
    bbox: null,
    outputs: [],
    dirHandle: null
  };

