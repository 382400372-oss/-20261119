<script>
(function(){
  var MAX_N = 512;
  var DEFAULT_N = 60;

  var state = {
    step: 1, videoFile: null, videoDuration: 0, videoWidth: 0, videoHeight: 0, N: DEFAULT_N,
    quality: 'original', targetW: 0, targetH: 0, allFrames: [], selectedIndices: [], currentPreviewIndex: 0,
    frames: [], ruleTypes: [], shapes: [], outputs: [], dirHandle: null, orderedCombos: []
  };

  var $ = function(id){ return document.getElementById(id); };

  function saveAs(blob, filename){
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a'); a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){ URL.revokeObjectURL(url); }, 2000);
  }

  function getVideoExt(blob){
    if(!blob || !blob.type) return '.mp4';
    return blob.type.toLowerCase().indexOf('webm') >= 0 ? '.webm' : '.mp4';
  }

  var __yieldMC = null;
  function fastYield(){
    if(typeof scheduler !== 'undefined' && scheduler && typeof scheduler.postTask === 'function'){
      try{ return scheduler.postTask(function(){}, { priority: 'user-visible' }); }catch(e){ }
    }
    if(typeof MessageChannel !== 'undefined'){
      if(!__yieldMC){ __yieldMC = new MessageChannel(); }
      return new Promise(function(resolve){ __yieldMC.port1.onmessage = function(){ resolve(); }; __yieldMC.port2.postMessage(null); });
    }
    return new Promise(function(r){ setTimeout(r, 0); });
  }

  $('videoInput').addEventListener('change', function(e){
    var f = this.files[0]; if(!f) return;
    state.videoFile = f;
    $('status1').innerHTML = '<span class="spinner"></span> 正在读取视频信息...';

    var v = document.createElement('video');
    v.preload = 'metadata'; v.muted = true; v.playsInline = true;
    v.src = URL.createObjectURL(f);
    v.onloadedmetadata = function(){
      state.videoDuration = v.duration; state.videoWidth = v.videoWidth; state.videoHeight = v.videoHeight;
      $('viName').textContent = f.name;
      var mins = Math.floor(v.duration/60), secs = (v.duration%60).toFixed(2);
      $('viDuration').textContent = mins > 0 ? mins + 'min ' + secs + 's' : secs + 's';
      $('viResolution').textContent = v.videoWidth + 'x' + v.videoHeight;
      $('videoInfoBox').classList.remove('hidden');
      $('status1').textContent = '视频已就绪，请滚动至第2步。';
      $('status1').style.color = 'var(--success)';
      updateQualityInfo();
      
      setTimeout(function(){ scrollToSec(2); }, 300);
    };
    v.onerror = function(){ $('status1').textContent = '视频读取失败'; $('status1').style.color = '#ff453a'; };
  });

  $('trackCount').addEventListener('input', function(){
    var val = parseInt(this.value) || DEFAULT_N;
    if(val < 2) val = 2; if(val > MAX_N) val = MAX_N; state.N = val;
  });

  document.querySelectorAll('#qualityRow .preset-btn').forEach(function(btn){
    btn.onclick = function(){
      document.querySelectorAll('#qualityRow .preset-btn').forEach(function(b){ b.classList.remove('selected'); });
      btn.classList.add('selected');
      state.quality = btn.dataset.quality;
      updateQualityInfo();
    };
  });

  function computeTargetSize(){
    var srcW = state.videoWidth, srcH = state.videoHeight;
    // 奇数分辨率强制向下取偶，防止编码器崩溃
    if(state.quality === 'original' || srcW === 0) {
        return {w: srcW - (srcW % 2), h: srcH - (srcH % 2)};
    }
    var targetW = state.quality === '1080p' ? 1920 : (state.quality === '2k' ? 2560 : 3840);
    if(targetW > srcW) targetW = srcW;
    var targetH = Math.round(srcH * targetW / srcW);
    return {w: targetW - (targetW%2), h: targetH - (targetH%2)};
  }

  function updateQualityInfo(){
    $('qiSource').textContent = state.videoWidth + ' x ' + state.videoHeight;
    var t = computeTargetSize();
    $('qiTarget').textContent = t.w + ' x ' + t.h + (state.quality === 'original' ? ' (原画质)' : '');
    $('startExtractBtn').disabled = false;
  }

  $('startExtractBtn').onclick = async function(){
    this.disabled = true;
    await extractFrames();
  };

  async function extractFrames(){
    state.N = Math.max(2, Math.min(MAX_N, parseInt($('trackCount').value)||DEFAULT_N));
    var total = state.N; var target = computeTargetSize();
    state.targetW = target.w; state.targetH = target.h;
    
    $('qualityArea').classList.add('hidden'); $('extractArea').classList.remove('hidden'); $('selectArea').classList.add('hidden');
    $('framePreviewGrid').innerHTML = '';
    $('progressBar2').style.width = '0%';
    $('status2').innerHTML = '<span class="spinner"></span> 正在读取...';

    var v = document.createElement('video'); v.muted = true; v.playsInline = true; v.preload = 'auto'; v.src = URL.createObjectURL(state.videoFile);
    await new Promise(function(res, rej){ v.onloadeddata = res; v.onerror = function(){ rej(new Error('加载失败')); }; });
    
    var dur = v.duration; state.allFrames = []; state.selectedIndices = [];

    for(var i=0; i<total; i++){
      v.currentTime = (i + 0.5) * dur / total;
      await new Promise(function(r){ var done = false; function fin(){ if(done)return; done=true; r(); } v.onseeked = function(){ setTimeout(fin, 40); }; setTimeout(fin, 800); });
      
      var c = document.createElement('canvas');
      c.width = target.w; c.height = target.h;
      c.getContext('2d').drawImage(v, 0, 0, target.w, target.h);
      
      state.allFrames.push(c); state.selectedIndices.push(i);

      $('progressBar2').style.width = ((i+1)/total*100) + '%';
      $('status2').innerHTML = '<span class="spinner"></span> 抽帧 ' + (i+1) + '/' + total;
      await fastYield();
    }

    $('extractArea').classList.add('hidden'); $('selectArea').classList.remove('hidden');
    $('extractCount').textContent = total;
    
    state.N = state.selectedIndices.length;
    state.frames = [];
    for(var k=0; k<state.selectedIndices.length; k++) state.frames.push(state.allFrames[state.selectedIndices[k]]);
    
    renderFrameSelector(); updateFrameCounter(); initSelectArea();
  }

  function initSelectArea(){
    state.currentPreviewIndex = 0;
    $('frameSlider').min = 0; $('frameSlider').max = Math.max(0, state.allFrames.length - 1); $('frameSlider').value = 0;
    updateFullPreview(); highlightFocusedThumb(0);
  }

  function updateFullPreview(){
    var src = state.allFrames[state.currentPreviewIndex];
    if(!src){ $('fullPreviewLabel').textContent = '帧 0 / 0'; return; }
    $('fullPreviewCanvas').width = src.width; $('fullPreviewCanvas').height = src.height;
    $('fullPreviewCanvas').getContext('2d').drawImage(src, 0, 0);
    $('fullPreviewLabel').textContent = '帧 ' + (state.currentPreviewIndex + 1) + ' / ' + state.allFrames.length;
    var isSel = state.selectedIndices.indexOf(state.currentPreviewIndex) >= 0;
    $('fullPreviewSelectedTag').textContent = isSel ? '已保留' : '已去掉';
    $('fullPreviewSelectedTag').style.color = isSel ? 'var(--success)' : '#ff453a';
  }

  function highlightFocusedThumb(i){
    var items = $('framePreviewGrid').querySelectorAll('.frame-item');
    for(var k=0; k<items.length; k++) items[k].classList.remove('focused');
    var el = $('framePreviewGrid').querySelector('.frame-item[data-idx="' + i + '"]');
    if(el) el.classList.add('focused');
  }

  function scrollThumbIntoView(i){
    var el = $('framePreviewGrid').querySelector('.frame-item[data-idx="' + i + '"]');
    if(el) el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  $('frameSlider').oninput = function(){ state.currentPreviewIndex = parseInt(this.value); updateFullPreview(); highlightFocusedThumb(this.value); scrollThumbIntoView(this.value); };
  $('prevFrameBtn').onclick = function(){ if(state.currentPreviewIndex > 0){ state.currentPreviewIndex--; $('frameSlider').value = state.currentPreviewIndex; updateFullPreview(); highlightFocusedThumb(state.currentPreviewIndex); scrollThumbIntoView(state.currentPreviewIndex); } };
  $('nextFrameBtn').onclick = function(){ if(state.currentPreviewIndex < state.allFrames.length - 1){ state.currentPreviewIndex++; $('frameSlider').value = state.currentPreviewIndex; updateFullPreview(); highlightFocusedThumb(state.currentPreviewIndex); scrollThumbIntoView(state.currentPreviewIndex); } };
  $('toggleSelectBtn').onclick = function(){ toggleFrameSelection(state.currentPreviewIndex); };

  function toggleFrameSelection(i){
    var pos = state.selectedIndices.indexOf(i);
    if(pos >= 0) state.selectedIndices.splice(pos, 1); else { state.selectedIndices.push(i); state.selectedIndices.sort(function(a,b){ return a-b; }); }
    updateFrameCounter(); updateThumbState(i); updateFullPreview();
    
    state.N = state.selectedIndices.length;
    state.frames = [];
    for(var k=0; k<state.selectedIndices.length; k++) state.frames.push(state.allFrames[state.selectedIndices[k]]);
  }

  function updateThumbState(i){
    var el = $('framePreviewGrid').querySelector('.frame-item[data-idx="' + i + '"]'); if(!el) return;
    var isSel = state.selectedIndices.indexOf(i) >= 0;
    el.classList.toggle('unselected', !isSel);
    var mark = el.querySelector('.unselected-mark');
    if(!isSel && !mark){ var d = document.createElement('div'); d.className = 'unselected-mark'; d.textContent = '×'; el.appendChild(d); }
    else if(isSel && mark) mark.remove();
  }

  function renderFrameSelector(){
    $('framePreviewGrid').innerHTML = '';
    var total = state.allFrames.length, idx = 0;
    function batch(){
      var end = Math.min(idx + 20, total);
      for(; idx<end; idx++){
        (function(i){
          var canvas = state.allFrames[i], isSel = state.selectedIndices.indexOf(i) >= 0;
          var div = document.createElement('div'); div.className = 'frame-item' + (isSel ? '' : ' unselected'); div.dataset.idx = i;
          var tc = document.createElement('canvas'); tc.width = 100; tc.height = Math.round(canvas.height*100/canvas.width); tc.getContext('2d').drawImage(canvas,0,0,tc.width,tc.height);
          var img = document.createElement('img'); img.src = tc.toDataURL('image/jpeg',0.6); div.appendChild(img);
          var span = document.createElement('span'); span.className = 'idx'; span.textContent = i+1; div.appendChild(span);
          if(!isSel){ var m = document.createElement('div'); m.className = 'unselected-mark'; m.textContent = '×'; div.appendChild(m); }
          div.onclick = function(){ state.currentPreviewIndex = i; $('frameSlider').value = i; toggleFrameSelection(i); highlightFocusedThumb(i); scrollThumbIntoView(i); };
          $('framePreviewGrid').appendChild(div);
        })(idx);
      }
      if(idx < total) requestAnimationFrame(batch);
    }
    batch();
  }

  function updateFrameCounter(){
    var sel = state.selectedIndices.length, total = state.allFrames.length;
    if(total === 0){ $('frameCounter').textContent = '有效帧 0 / 共 0 帧'; $('toStep3').disabled = true; return; }
    if(sel === total){ $('frameCounter').textContent = '有效帧 ' + sel + ' / 共 ' + total + ' 帧（全部保留）'; $('frameCounter').style.color = 'var(--success)'; $('toStep3').disabled = false; }
    else if(sel >= 1){ $('frameCounter').textContent = '有效帧 ' + sel + ' / 共 ' + total + ' 帧（已去掉 ' + (total-sel) + ' 帧）'; $('frameCounter').style.color = 'var(--accent)'; $('toStep3').disabled = false; }
    else { $('frameCounter').textContent = '有效帧 0 / 共 ' + total + ' 帧（至少保留 1 帧）'; $('frameCounter').style.color = '#ff453a'; $('toStep3').disabled = true; }
  }

  $('toStep3').onclick = function(){
    if(state.selectedIndices.length < 1){ alert('至少保留 1 帧'); return; }
    state.N = state.selectedIndices.length;
    state.frames = [];
    for(var i = 0; i < state.selectedIndices.length; i++){
      state.frames.push(state.allFrames[state.selectedIndices[i]]);
    }
    // 物理销毁未选中的帧，强行释放 4K 内存
    for (var j = 0; j < state.allFrames.length; j++) {
        if (state.selectedIndices.indexOf(j) < 0 && state.allFrames[j]) {
            state.allFrames[j].width = 0;
            state.allFrames[j].height = 0;
        }
    }
    scrollToSec(3);
  };

  var SHAPES = [
    { id: 'original', icon: '🎬', name: '原视频' }, { id: 'foldline', icon: '⇗', name: '半扇折线' },
    { id: 'foldline90', icon: '⇖', name: '半扇垂线' }, { id: 'vertical', icon: '▥', name: '竖切' },
    { id: 'horizontal', icon: '▤', name: '横切' }, { id: 'semicircle', icon: '◒', name: '半扇' },
    { id: 'leftsemicircle', icon: '◐', name: '左半扇' }, { id: 'sector', icon: '🌀', name: '全扇' },
    { id: 'ring', icon: '◎', name: '圆形' }, { id: 'halfring', icon: '◠', name: '半圆' },
    { id: 'diamond', icon: '◇', name: '菱形' }, { id: 'square', icon: '▢', name: '正方形' },
    { id: 'heart', icon: '♡', name: '爱心' }, { id: 'star', icon: '☆', name: '五角星' },
    { id: 'hexagon', icon: '⬡', name: '六边形' }, { id: 'octagon', icon: '🛑', name: '八边形' },
    { id: 'hexagram', icon: '✡️', name: '六角星' }
  ];

  SHAPES.forEach(function(s){
    var card = document.createElement('div'); card.className = 'choice-card'; card.dataset.shape = s.id;
    card.innerHTML = '<span class="icon">' + s.icon + '</span><div class="label">' + s.name + '</div>';
    card.onclick = function(){
      var idx = state.shapes.indexOf(s.id);
      if(idx >= 0){ state.shapes.splice(idx, 1); card.classList.remove('selected'); }
      else { state.shapes.push(s.id); card.classList.add('selected'); }
      checkStep3();
    };
    $('shapeGrid').appendChild(card);
  });

  document.querySelectorAll('[data-type]').forEach(function(card){
    card.onclick = function(){
      var t = card.dataset.type, idx = state.ruleTypes.indexOf(t);
      if(idx >= 0){ state.ruleTypes.splice(idx, 1); card.classList.remove('selected'); }
      else { state.ruleTypes.push(t); card.classList.add('selected'); }
      checkStep3();
    };
  });

  function getCombos(){
    var combos = [];
    for(var i=0;i<state.shapes.length;i++){
      var sh = state.shapes[i];
      if(sh === 'original') combos.push({shape: sh, ruleType: null, name: '原视频'});
      else for(var j=0;j<state.ruleTypes.length;j++) combos.push({shape: sh, ruleType: state.ruleTypes[j], name: getRuleShort(state.ruleTypes[j]) + '_' + getShapeName(sh)});
    }
    return combos;
  }

  function getShapeName(id){ for(var i=0;i<SHAPES.length;i++){ if(SHAPES[i].id === id) return SHAPES[i].name; } return id; }
  function getRuleShort(id){ if(id === 'loop') return '循环'; if(id === 'wave') return '波浪'; if(id === 'expand') return '展开'; if(id === 'waveexpand') return '波浪展开'; return id; }
  function getRuleName(id){ if(id === 'loop') return '循环类'; if(id === 'wave') return '波浪循环类'; if(id === 'expand') return '展开类'; if(id === 'waveexpand') return '波浪展开类'; return '-'; }

  function checkStep3(){
    var newCombos = getCombos();
    // 保护用户已经拖拽好的顺序
    var oldOrderNames = state.orderedCombos.map(function(c){ return c.name; });
    newCombos.sort(function(a, b){
        var idxA = oldOrderNames.indexOf(a.name);
        var idxB = oldOrderNames.indexOf(b.name);
        if(idxA === -1 && idxB === -1) return 0;
        if(idxA === -1) return 1; // 新加的排后面
        if(idxB === -1) return -1;
        return idxA - idxB;
    });
    
    state.orderedCombos = newCombos;
    updateSummary();
  }

  $('pickFolderBtn').onclick = async function(){
    if(!window.showDirectoryPicker){ alert('浏览器不支持文件夹选择。'); return; }
    try{
      var handle = await window.showDirectoryPicker({ mode: 'readwrite' });
      state.dirHandle = handle;
      $('folderName').innerHTML = '<span style="color:var(--success);">已选择：</span>' + handle.name;
    }catch(err){ if(err.name !== 'AbortError') alert('选择失败：' + err.message); }
  };

  function getTargetDuration(){
    var T = parseFloat($('targetDuration').value);
    if(isNaN(T) || T <= 0.1) T = 2;
    return T;
  }

  function renderComboList(){
    $('comboList').innerHTML = '';
    state.orderedCombos.forEach(function(c, i){
      var div = document.createElement('div'); div.className = 'combo-item'; div.draggable = true; div.dataset.index = i;
      div.innerHTML = '<span style="color:var(--text-sub);margin-right:12px;">⋮⋮</span><span class="tag">' + (i+1) + '</span><span>' + (c.shape==='original'?'原视频':getRuleName(c.ruleType)+' x '+getShapeName(c.shape)) + '</span>';
      div.ondragstart = function(e){ dragSrcEl = this; e.dataTransfer.effectAllowed='move'; this.classList.add('dragging'); };
      div.ondragover = function(e){ e.preventDefault(); this.classList.add('over'); };
      div.ondragleave = function(){ this.classList.remove('over'); };
      div.ondrop = function(e){
        e.stopPropagation(); this.classList.remove('over');
        if(dragSrcEl !== this){
          var from = parseInt(dragSrcEl.dataset.index), to = parseInt(this.dataset.index);
          var item = state.orderedCombos.splice(from, 1)[0];
          state.orderedCombos.splice(to, 0, item);
          setTimeout(renderComboList, 10);
        }
      };
      div.ondragend = function(){ this.classList.remove('dragging'); document.querySelectorAll('.combo-item').forEach(function(el){ el.classList.remove('over'); }); };
      $('comboList').appendChild(div);
    });
  }
  var dragSrcEl = null;

  function updateSummary(){
    $('summaryBox').innerHTML = '<div class="info-card"><span class="k">有效帧数</span><span class="v">' + state.N + '</span></div>' +
                                '<div class="info-card"><span class="k">输出尺寸</span><span class="v">' + state.targetW + ' x ' + state.targetH + '</span></div>';
    renderComboList();
  }

  function waveBase(p, N){ if(N<=1) return 0; var raw = (N-1)*(1-Math.abs(2*p/(N-1)-1)); return Math.max(0, Math.min(N-1, Math.round(raw))); }
  function computeImgIndex(ruleType, trackIdx, outIdx, N){
    if(ruleType === 'loop') return ((trackIdx - outIdx) % N + N) % N;
    if(ruleType === 'wave') return waveBase(((trackIdx - outIdx) % N + N) % N, N);
    if(ruleType === 'waveexpand') return (trackIdx <= outIdx) ? waveBase(trackIdx, N) : 0;
    return (trackIdx <= outIdx) ? trackIdx : 0;
  }
  function rotatePoint(p, ang){ var c = Math.cos(ang), s = Math.sin(ang); return [p[0]*c - p[1]*s, p[0]*s + p[1]*c]; }

  function clipShape(ctx, shape, t, N, W, H, cx, cy, Rmax){
    ctx.beginPath();
    var step = Rmax / N;
    var pad = 1.5; // 全局外扩像素量，抗锯齿重合
    
    if(shape === 'halfring'){ 
        ctx.arc(W/2, H, (t+1)*(Math.sqrt((W/2)*(W/2)+H*H)/N) + pad, Math.PI, 2*Math.PI); 
    }
    else if(shape === 'leftsemicircle'){ 
        var asL = Math.PI / N;
        var aL1 = -Math.PI / 2 + t * asL;
        var aL2 = aL1 + asL;
        ctx.moveTo(0, cy);
        ctx.arc(0, cy, Rmax * 3, aL1 - 0.005, aL2 + 0.005); 
        ctx.closePath();
    }
    else if(shape === 'foldline90'){
        var aq90 = W / 4 + pad;
        var Rfar90 = Math.max(W, H) * 5;
        var th1_90 = t * 2 * Math.PI / N;
        var th2_90 = (t + 1) * 2 * Math.PI / N;
        var P1_90 = [0, -aq90];
        var P2_90 = [Rfar90, -aq90];
        var p1a_90 = rotatePoint(P1_90, th1_90 - 0.01);
        var p2a_90 = rotatePoint(P2_90, th1_90 - 0.01);
        var p1b_90 = rotatePoint(P1_90, th2_90 + 0.01);
        var p2b_90 = rotatePoint(P2_90, th2_90 + 0.01);
        ctx.moveTo(cx, cy);
        ctx.lineTo(cx + p1a_90[0], cy + p1a_90[1]);
        ctx.lineTo(cx + p2a_90[0], cy + p2a_90[1]);
        ctx.lineTo(cx + p2b_90[0], cy + p2b_90[1]);
        ctx.lineTo(cx + p1b_90[0], cy + p1b_90[1]);
        ctx.closePath();
    }
    else if(shape === 'vertical'){ 
        var sw = W/N;
        ctx.rect(t*sw - pad, -pad, sw + pad*2, H + pad*2);
    }
    else if(shape === 'horizontal'){ 
        var sh = H/N;
        ctx.rect(-pad, t*sh - pad, W + pad*2, sh + pad*2);
    }
    else if(shape === 'semicircle'){
        var as = Math.PI/N;
        var a1 = -Math.PI + t*as;
        var a2 = a1 + as;
        ctx.moveTo(cx, H);
        ctx.arc(cx, H, Rmax*3, a1 - 0.005, a2 + 0.005);
        ctx.closePath();
    }
    else if(shape === 'sector'){
        var as2 = 2*Math.PI/N;
        var a3 = t*as2;
        var a4 = a3 + as2;
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, Rmax*3, a3 - 0.005, a4 + 0.005);
        ctx.closePath();
    }
    else if(shape === 'ring'){
        var r1 = (t+1)*step + pad;
        ctx.arc(cx, cy, r1, 0, 2*Math.PI);
    }
    else if(shape === 'diamond'){
        var r2 = (t+1)*step + pad;
        var d = r2 * Math.SQRT2;
        ctx.moveTo(cx, cy-d);
        ctx.lineTo(cx+d, cy);
        ctx.lineTo(cx, cy+d);
        ctx.lineTo(cx-d, cy);
        ctx.closePath();
    }
    else if(shape === 'square'){
        var r3 = (t+1)*step + pad;
        ctx.rect(cx-r3, cy-r3, 2*r3, 2*r3);
    }
    else if(shape === 'heart'){
        var r4 = (t+1)*step + pad;
        var scale = r4/5;
        var total = 120;
        for(var j=0;j<=total;j++){
          var ang = (j/total)*2*Math.PI;
          var x = 16*Math.pow(Math.sin(ang),3);
          var y = -(13*Math.cos(ang) - 5*Math.cos(2*ang) - 2*Math.cos(3*ang) - Math.cos(4*ang));
          var px = cx + x*scale;
          var py = cy + y*scale;
          if(j===0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.closePath();
    }
    else if(shape === 'star'){
        var r5 = (t+1)*step + pad;
        var innerRatio = Math.sin(Math.PI/10)/Math.sin(3*Math.PI/10);
        var outerR = r5/innerRatio;
        var innerR = r5;
        for(var k2=0;k2<10;k2++){
          var radius = (k2%2===0) ? outerR : innerR;
          var ang2 = -Math.PI/2 + k2*Math.PI/5;
          var x2 = cx + radius*Math.cos(ang2);
          var y2 = cy + radius*Math.sin(ang2);
          if(k2===0) ctx.moveTo(x2, y2); else ctx.lineTo(x2, y2);
        }
        ctx.closePath();
    }
    else if(shape === 'hexagon'){
        var r6 = (t+1)*step + pad;
        var vertexR6 = r6 / Math.cos(Math.PI/6);
        var sides6 = 6;
        for(var j6=0;j6<sides6;j6++){
          var ang6 = -Math.PI/2 + j6 * (2*Math.PI/sides6);
          var x6 = cx + vertexR6*Math.cos(ang6);
          var y6 = cy + vertexR6*Math.sin(ang6);
          if(j6===0) ctx.moveTo(x6,y6); else ctx.lineTo(x6,y6);
        }
        ctx.closePath();
    }
    else if(shape === 'octagon'){
        var r8 = (t+1)*step + pad;
        var vertexR8 = r8 / Math.cos(Math.PI/8);
        var sides8 = 8;
        for(var j8=0;j8<sides8;j8++){
          var ang8 = -Math.PI/2 + j8 * (2*Math.PI/sides8);
          var x8 = cx + vertexR8*Math.cos(ang8);
          var y8 = cy + vertexR8*Math.sin(ang8);
          if(j8===0) ctx.moveTo(x8,y8); else ctx.lineTo(x8,y8);
        }
        ctx.closePath();
    }
    else if(shape === 'hexagram'){
        var r6s = (t+1)*step + pad;
        var innerRatio6 = Math.cos(2*Math.PI/6) / Math.cos(Math.PI/6);
        var outerR6 = r6s/innerRatio6;
        var innerR6 = r6s;
        var points6 = 6;
        for(var k6=0;k6<points6*2;k6++){
          var radius6 = (k6%2===0) ? outerR6 : innerR6;
          var ang6s = -Math.PI/2 + k6*Math.PI/6;
          var x6s = cx + radius6*Math.cos(ang6s);
          var y6s = cy + radius6*Math.sin(ang6s);
          if(k6===0) ctx.moveTo(x6s, y6s); else ctx.lineTo(x6s, y6s);
        }
        ctx.closePath();
    }
    else if(shape === 'foldline'){
        var aq = W / 4 + pad;
        var Rfar = Math.max(W, H) * 5;
        var th1 = t * 2 * Math.PI / N;
        var th2 = (t + 1) * 2 * Math.PI / N;
        var P1 = [0, -aq];
        var P2 = [Rfar, -Rfar - aq];
        var p1a = rotatePoint(P1, th1 - 0.01);
        var p2a = rotatePoint(P2, th1 - 0.01);
        var p1b = rotatePoint(P1, th2 + 0.01);
        var p2b = rotatePoint(P2, th2 + 0.01);
        ctx.moveTo(cx, cy);
        ctx.lineTo(cx + p1a[0], cy + p1a[1]);
        ctx.lineTo(cx + p2a[0], cy + p2a[1]);
        ctx.lineTo(cx + p2b[0], cy + p2b[1]);
        ctx.lineTo(cx + p1b[0], cy + p1b[1]);
        ctx.closePath();
    }
    ctx.clip();
  }

  async function generateSlicesFor(shape, ruleType, comboName, comboIdx, totalCombos, onProgress){
    var N = state.N;
    var W = state.targetW;
    var H = state.targetH;

    if(shape === 'original'){
      var blobsRaw = [];
      for(var k=0;k<N;k++){
        var blob = await new Promise(function(r){ state.frames[k].toBlob(r, 'image/png'); });
        blobsRaw.push(blob);
        onProgress(k+1, N, '原视频');
        await fastYield();
      }
      return blobsRaw;
    }

    var cx = W/2, cy = H/2;
    var Rmax = Math.sqrt(cx*cx + cy*cy);
    var canvas = document.createElement('canvas');
    canvas.width = W;
    canvas.height = H;
    var ctx = canvas.getContext('2d');
    var blobs = [];

    for(var k=0;k<N;k++){
      ctx.clearRect(0, 0, W, H);
      for(var t=N-1;t>=0;t--){
        var imgIdx = computeImgIndex(ruleType, t, k, N);
        var imgCanvas = state.frames[imgIdx];
        ctx.save();
        clipShape(ctx, shape, t, N, W, H, cx, cy, Rmax);
        ctx.drawImage(imgCanvas, 0, 0, W, H);
        ctx.restore();
      }
      
      var blob = await new Promise(function(r){ canvas.toBlob(r, 'image/png'); });
      blobs.push(blob);
      onProgress(k+1, N, comboName);
      
      await fastYield();
    }
    return blobs;
  }

  async function composeVideo(sliceBlobs, T, fps, comboName, onProgress){
    if(typeof VideoEncoder === 'undefined') throw new Error('浏览器不支持 WebCodecs');
    if(typeof Mp4Muxer === 'undefined') throw new Error('mp4-muxer 未加载');

    var firstBmp = await createImageBitmap(sliceBlobs[0]);
    var W = firstBmp.width - (firstBmp.width % 2);
    var H = firstBmp.height - (firstBmp.height % 2);
    firstBmp.close();
    
    var candidates = ['avc1.640033','avc1.640028','avc1.4d0028','avc1.64001f','avc1.42001f'];
    var cfg = null;
    for(var ci = 0; ci < candidates.length; ci++){
      // 强制 1 FPS 生成，逼迫编码器放弃秒级关键帧插入，全量采用 I 帧确保画质极佳
      var c = { codec: candidates[ci], width: W, height: H, bitrate: 80000000, framerate: 1 };
      try{
        var s = await VideoEncoder.isConfigSupported(c);
        if(s && s.supported){ cfg = c; break; }
      }catch(e){ }
    }
    if(!cfg) throw new Error('没有可用的 H.264 编码配置');

    var muxer = new Mp4Muxer.Muxer({
      target: new Mp4Muxer.ArrayBufferTarget(),
      video: { codec: 'avc', width: W, height: H },
      fastStart: 'in-memory'
    });

    var encodeError = null;
    var enc = new VideoEncoder({
      output: function(chunk, meta){
        // 封装层快放：把原本 1 秒 1 帧的 chunk 强行压缩成 T 秒的快放时间戳
        if(chunk.timestamp >= 0){
          var newTimestamp = Math.round(chunk.timestamp / 1000000 * (1000000 / sliceBlobs.length) * T);
          var newData = new Uint8Array(chunk.byteLength);
          chunk.copyTo(newData);
          var newChunk = new EncodedVideoChunk({
            type: chunk.type,
            timestamp: newTimestamp,
            duration: Math.round((1000000 / sliceBlobs.length) * T),
            data: newData
          });
          muxer.addVideoChunk(newChunk, meta);
        } else {
          muxer.addVideoChunk(chunk, meta);
        }
      },
      error: function(e){ encodeError = e; }
    });
    enc.configure(cfg);

    // 原始生成的 1fps 时间戳间隔
    var usPer = 1000000; 

    for(var i = 0; i < sliceBlobs.length; i++){
      if(encodeError) throw encodeError;
      
      var bmp = await createImageBitmap(sliceBlobs[i]);
      // 全部标记为关键帧，绝不走帧间预测，这是不花屏的终极秘诀
      var frame = new VideoFrame(bmp, { timestamp: i * usPer, duration: usPer });
      enc.encode(frame, { keyFrame: true });
      frame.close();
      bmp.close();
      
      onProgress(i+1, sliceBlobs.length, comboName);
      await fastYield();
    }

    await enc.flush();
    enc.close();
    if(encodeError) throw encodeError;
    muxer.finalize();
    
    return new Blob([muxer.target.buffer], { type: 'video/mp4' });
  }

  async function saveBlobToFolder(blob, filename){
    if(!state.dirHandle) throw new Error('未选择输出文件夹');
    var fileHandle = await state.dirHandle.getFileHandle(filename, { create: true });
    var writable = await fileHandle.createWritable(); await writable.write(blob); await writable.close();
  }

  $('generateBtn').onclick = async function(){
    // 精准错误提示
    let miss = [];
    if(!state.videoFile) miss.push("上传视频");
    if(!state.selectedIndices || state.selectedIndices.length === 0) miss.push("抽取并确认帧");
    if(!state.shapes || state.shapes.length === 0) {
        miss.push("选择形状");
    } else {
        var hasNonOriginal = state.shapes.some(function(s){ return s !== 'original'; });
        if(hasNonOriginal && (!state.ruleTypes || state.ruleTypes.length === 0)) {
            miss.push("选择大类型");
        }
    }

    if(miss.length > 0){
        $('status4').textContent = "缺少步骤：" + miss.join("、");
        $('status4').style.color = 'var(--danger)';
        return;
    }

    enterPerformanceMode('正在初始化引擎...');
    this.disabled = true;
    
    $('outputList').innerHTML = ''; state.outputs = [];
    var totalCombos = state.orderedCombos.length;
    
    var T = getTargetDuration();

    try{
      for(var ci=0; ci<totalCombos; ci++){
        var combo = state.orderedCombos[ci];
        var comboBase = ci / totalCombos;
        var comboSlice = 1 / totalCombos;

        var slices = await generateSlicesFor(combo.shape, combo.ruleType, combo.name, ci, totalCombos, function(cur, total, cName){
          var pct = (comboBase + (cur/total) * comboSlice * 0.5) * 100;
          updateProgressUI(pct, '正在处理: <strong>' + cName + '</strong> (' + (ci+1) + '/' + totalCombos + ')<br>切片中: ' + cur + ' / ' + total + ' 帧');
        });

        var mp4 = null;
        try{ 
          mp4 = await composeVideo(slices, T, 0, combo.name, function(cur, total, cName){
            var pct = (comboBase + comboSlice * 0.5 + (cur/total) * comboSlice * 0.5) * 100;
            updateProgressUI(pct, '正在处理: <strong>' + cName + '</strong> (' + (ci+1) + '/' + totalCombos + ')<br>编码中: ' + cur + ' / ' + total + ' 帧');
          }); 
        }catch(err){ 
          throw err;
        }
        
        var ext = getVideoExt(mp4);
        if(mp4 && state.dirHandle){
          updateProgressUI(99, '正在写入文件...');
          await saveBlobToFolder(mp4, combo.name + ext);
        }
        
        state.outputs.push({name: combo.name, blob: mp4, ext: ext});
      }

      updateProgressUI(100, '全部生成完成！');
      
      setTimeout(function(){
        exitPerformanceMode();
        renderOutputs();
        $('generateBtn').disabled = false;
      }, 800);

    }catch(err){
      console.error(err);
      updateProgressUI(0, '出错：' + err.message);
      setTimeout(function(){
        exitPerformanceMode();
        $('generateBtn').disabled = false;
      }, 3000);
    }
  };

  function renderOutputs(){
    $('outputList').innerHTML = '';
    var tip = document.createElement('div');
    tip.style = 'font-size:.85rem;color:var(--text-sub);margin-bottom:12px;';
    tip.textContent = state.dirHandle ? '文件已自动保存至文件夹。' : '请下载生成的视频。';
    $('outputList').appendChild(tip);

    state.outputs.forEach(function(out, i){
      var item = document.createElement('div'); item.className = 'combo-item'; item.style.cursor = 'default';
      var isWebm = out.ext === '.webm';
      item.innerHTML = '<span style="flex:1;color:' + (isWebm ? '#ffd60a' : 'var(--success)') + ';">' + (i+1) + '. ' + out.name + out.ext + (isWebm ? ' (WebM)' : '') + '</span>';
      
      if(!state.dirHandle && out.blob){
        var btn = document.createElement('button'); btn.className = 'btn small'; btn.textContent = '下载';
        btn.onclick = function(){ saveAs(out.blob, out.name + out.ext); };
        item.appendChild(btn);
      }
      $('outputList').appendChild(item);
    });
  }

})();
</script>

