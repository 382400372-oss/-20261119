  async function processOneVideo(file, onProgress, idx, total){
    var v = document.createElement('video');
    v.muted = true;
    v.playsInline = true;
    v.preload = 'auto';
    v.style.position = 'fixed';
    v.style.top = '0';
    v.style.left = '0';
    v.style.width = '4px';
    v.style.height = '4px';
    v.style.opacity = '0.01';
    v.style.pointerEvents = 'none';
    document.body.appendChild(v);
    v.src = URL.createObjectURL(file);

    await new Promise(function(res){
      var ok = false;
      function onCanPlay(){
        if(ok) return;
        ok = true;
        v.removeEventListener('canplay', onCanPlay);
        res();
      }
      v.addEventListener('canplay', onCanPlay);
      v.addEventListener('error', function(){
        if(ok) return;
        ok = true;
        res();
      });
      setTimeout(function(){ if(!ok){ ok = true; res(); } }, 8000);
    });

    var W = v.videoWidth;
    var H = v.videoHeight;
    var duration = v.duration;

    var outX = 0, outY = 0, outW = W, outH = H;
    if(state.smartCrop && state.bbox){
      var scaleX = W / state.refW;
      var scaleY = H / state.refH;
      outX = Math.floor(state.bbox.x * scaleX);
      outY = Math.floor(state.bbox.y * scaleY);
      outW = Math.floor(state.bbox.w * scaleX);
      outH = Math.floor(state.bbox.h * scaleY);
      outW = Math.max(2, outW - (outW % 2));
      outH = Math.max(2, outH - (outH % 2));
      if(outX + outW > W) outW = W - outX - ((W - outX) % 2);
      if(outY + outH > H) outH = H - outY - ((H - outY) % 2);
    }

    var outCanvas = document.createElement('canvas');
    outCanvas.width = outW;
    outCanvas.height = outH;
    var outCtx = outCanvas.getContext('2d', { alpha: true });

    var tmpCanvas = document.createElement('canvas');
    tmpCanvas.width = W;
    tmpCanvas.height = H;
    var tmpCtx = tmpCanvas.getContext('2d', { alpha: true });

    if(state.transparentBg){
      outCtx.clearRect(0, 0, outW, outH);
    } else {
      outCtx.fillStyle = state.bgColor;
      outCtx.fillRect(0, 0, outW, outH);
    }

    var mimeType = null;
    if(state.transparentBg){
      if(MediaRecorder.isTypeSupported('video/webm;codecs=vp9')) mimeType = 'video/webm;codecs=vp9';
      else if(MediaRecorder.isTypeSupported('video/webm;codecs=vp8')) mimeType = 'video/webm;codecs=vp8';
      else if(MediaRecorder.isTypeSupported('video/webm')) mimeType = 'video/webm';
      else throw new Error('浏览器不支持 WebM 录制');
    } else {
      if(MediaRecorder.isTypeSupported('video/mp4;codecs=avc1')) mimeType = 'video/mp4;codecs=avc1';
      else if(MediaRecorder.isTypeSupported('video/mp4')) mimeType = 'video/mp4';
      else throw new Error('浏览器不支持 MP4 录制');
    }

    var stream = outCanvas.captureStream(60);
    var recorder = new MediaRecorder(stream, {
      mimeType: mimeType,
      videoBitsPerSecond: 30000000
    });

    var chunks = [];
    recorder.ondataavailable = function(e){
      if(e.data && e.data.size > 0) chunks.push(e.data);
    };

    function drawFrame(){
      tmpCtx.clearRect(0, 0, W, H);
      tmpCtx.globalCompositeOperation = 'source-over';
      tmpCtx.drawImage(v, 0, 0, W, H);
      tmpCtx.globalCompositeOperation = 'destination-in';
      tmpCtx.drawImage(state.maskCanvas, 0, 0, W, H);
      tmpCtx.globalCompositeOperation = 'source-over';

      if(state.transparentBg){
        outCtx.clearRect(0, 0, outW, outH);
      } else {
        outCtx.fillStyle = state.bgColor;
        outCtx.fillRect(0, 0, outW, outH);
      }
      outCtx.drawImage(tmpCanvas, outX, outY, outW, outH, 0, 0, outW, outH);
    }

    v.currentTime = 0;
    await new Promise(function(res){
      var done = false;
      function finish(){ if(done) return; done = true; res(); }
      v.addEventListener('seeked', function onS(){
        v.removeEventListener('seeked', onS);
        setTimeout(finish, 100);
      });
      setTimeout(finish, 600);
    });

    drawFrame();

    return new Promise(async function(resolve){
      recorder.start(1000);

      try {
        await v.play();
      } catch(e){
        try { recorder.stop(); } catch(err){}
        try { v.removeAttribute('src'); v.load(); v.parentNode.removeChild(v); } catch(err){}
        resolve(null);
        return;
      }

      function renderLoop(){
        if(v.paused || v.ended) return;
        drawFrame();
        var pct = Math.min(1, v.currentTime / duration);
        onProgress(pct, v.currentTime, duration, idx, total);
        requestAnimationFrame(renderLoop);
      }

      v.addEventListener('ended', function(){
        drawFrame();
        onProgress(1, duration, duration, idx, total);
        setTimeout(function(){
          try { recorder.stop(); } catch(e){}
        }, 250);
      });

      recorder.onstop = function(){
        try {
          v.pause();
          v.removeAttribute('src');
          v.load();
          if(v.parentNode) v.parentNode.removeChild(v);
        } catch(e){}
        resolve(new Blob(chunks, {type: mimeType}));
      };

      renderLoop();
    });
  }

  generateBtn.onclick = async function(){
    let miss = [];
    if(state.videoFiles.length === 0) miss.push("上传视频");
    if(!state.maskCanvas) miss.push("绘制遮罩");
    
    if(miss.length > 0){
        $('mt_status4').textContent = "缺少步骤：" + miss.join("、");
        $('mt_status4').style.color = 'var(--danger)';
        return;
    }

    if(state.smartCrop){
      var bbox = computeBoundingBox();
      state.bbox = bbox;
      if(!bbox){
        alert('遮罩为空，请先在步骤2刷出内容。');
        return;
      }
    }

    enterPerformanceMode('正在初始化抠图引擎...');
    
    generateBtn.disabled = true;
    resultBox.classList.add('hidden');
    resultList.innerHTML = '';
    state.outputs = [];

    var totalVideos = state.videoFiles.length;

    try{
      for(var vi = 0; vi < totalVideos; vi++){
        var file = state.videoFiles[vi];
        var baseName = file.name.replace(/\.[^.]+$/, '');
        var ext = state.transparentBg ? '.webm' : '.mp4';

        var blob = await processOneVideo(file, function(pct, cur, total, idx, tot){
          var globalPct = (idx + pct) / tot * 100;
          updateProgressUI(globalPct, '正在批量抠图 (' + (idx+1) + '/' + tot + ')<br>当前处理: ' + cur.toFixed(1) + 's / ' + total.toFixed(1) + 's');
        }, vi, totalVideos);

        var outName = baseName + '_抠图' + ext;

        if(state.dirHandle){
          try {
            var fh = await state.dirHandle.getFileHandle(outName, { create: true });
            var writable = await fh.createWritable();
            await writable.write(blob);
            await writable.close();
          } catch(e){ console.warn('写入失败', e); }
        }

        state.outputs.push({ name: outName, blob: blob });
      }

      updateProgressUI(100, '全部完成！准备下载。');
      
      setTimeout(function(){
        exitPerformanceMode();
        if(state.outputs.length > 0){
          resultVideo.src = URL.createObjectURL(state.outputs[0].blob);
        }
        renderResultList();
        resultBox.classList.remove('hidden');
        generateBtn.disabled = false;
      }, 800);

    }catch(err){
      console.error(err);
      updateProgressUI(0, '出错：' + err.message);
      setTimeout(function(){
        exitPerformanceMode();
        generateBtn.disabled = false;
      }, 3000);
    }
  };

  function renderResultList(){
    resultList.innerHTML = '';
    for(var i=0;i<state.outputs.length;i++){
      (function(idx){
        var out = state.outputs[idx];
        var item = document.createElement('div');
        item.className = 'video-item';
        var num = document.createElement('div');
        num.className = 'num';
        num.textContent = idx + 1;
        item.appendChild(num);
        var name = document.createElement('div');
        name.className = 'name';
        name.textContent = out.name;
        item.appendChild(name);
        var actions = document.createElement('div');
        actions.className = 'actions';

        var dl = document.createElement('button');
        dl.className = 'btn tiny';
        dl.textContent = '下载';
        dl.onclick = function(){
          var url = URL.createObjectURL(out.blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = out.name;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(function(){ URL.revokeObjectURL(url); }, 2000);
        };
        actions.appendChild(dl);

        var pv = document.createElement('button');
        pv.className = 'btn tiny secondary';
        pv.textContent = '预览';
        pv.onclick = function(){
          resultVideo.src = URL.createObjectURL(out.blob);
        };
        actions.appendChild(pv);

        item.appendChild(actions);
        resultList.appendChild(item);
      })(i);
    }
  }

  downloadBtn.onclick = function(){
    for(var i=0;i<state.outputs.length;i++){
      (function(out, idx){
        setTimeout(function(){
          var url = URL.createObjectURL(out.blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = out.name;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(function(){ URL.revokeObjectURL(url); }, 2000);
        }, idx * 500);
      })(state.outputs[i], i);
    }
  };

  updateUndoBtn();
  updatePolygonActions();
  updateFormatNote();
})();
</script>
</body>
</html>
