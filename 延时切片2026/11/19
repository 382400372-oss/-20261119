  function computeBoundingBox(){
    if(!state.maskCtx) return null;
    var W = state.refW, H = state.refH;
    var data = state.maskCtx.getImageData(0, 0, W, H).data;
    var minX = W, minY = H, maxX = -1, maxY = -1;
    for(var y = 0; y < H; y++){
      var rowOff = y * W * 4;
      for(var x = 0; x < W; x++){
        var a = data[rowOff + x * 4 + 3];
        if(a > 20){
          if(x < minX) minX = x;
          if(x > maxX) maxX = x;
          if(y < minY) minY = y;
          if(y > maxY) maxY = y;
        }
      }
    }
    if(maxX < 0) return null;
    return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };
  }

  function updateBboxInfo(){
    if(!state.smartCrop){
      bboxInfo.style.display = 'none';
      state.bbox = null;
      return;
    }
    var bbox = computeBoundingBox();
    state.bbox = bbox;
    if(!bbox){
      bboxInfo.style.display = 'block';
      bboxInfo.textContent = '警告：遮罩为空，请先在步骤2刷出内容。';
      bboxInfo.style.color = '#ff453a';
      bboxInfo.style.background = '#fff0f0';
      return;
    }
    var scaleX = state.W / state.refW;
    var scaleY = state.H / state.refH;
    var outW = Math.floor(bbox.w * scaleX);
    var outH = Math.floor(bbox.h * scaleY);
    outW = outW - (outW % 2);
    outH = outH - (outH % 2);
    bboxInfo.style.display = 'block';
    bboxInfo.style.color = '#856404';
    bboxInfo.style.background = '#fff3cd';
    bboxInfo.textContent = '智能裁切：输出尺寸 ' + outW + ' × ' + outH + '（原尺寸 ' + state.W + ' × ' + state.H + '）';
  }

