<script>
/* 全局控制 */
window.scrollToSec = function(n) {
  var el = document.getElementById('section' + n);
  if(el) {
    var yOffset = el.getBoundingClientRect().top + window.pageYOffset - 80;
    window.scrollTo({ top: yOffset, behavior: 'smooth' });
  }
};

window.switchMode = function(mode) {
  var btnDelay = document.getElementById('btn-mode-delay');
  var btnMatting = document.getElementById('btn-mode-matting');
  var appDelay = document.getElementById('app-delay');
  var appMatting = document.getElementById('app-matting');
  var navDelay = document.getElementById('delay-nav-links');

  if(mode === 'delay') {
    btnDelay.classList.add('active');
    btnMatting.classList.remove('active');
    appDelay.style.display = 'block';
    appMatting.style.display = 'none';
    navDelay.style.display = 'flex';
    window.scrollTo({top: 0, behavior: 'smooth'});
  } else {
    btnDelay.classList.remove('active');
    btnMatting.classList.add('active');
    appDelay.style.display = 'none';
    appMatting.style.display = 'block';
    navDelay.style.display = 'none';
    window.scrollTo({top: 0, behavior: 'smooth'});
  }
};

/* 视口观察器 */
var observer = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      entry.target.classList.add('active');
    }
  });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(function(el){ observer.observe(el); });

/* ========================================= */
/* 性能隔离 + 独立的 rAF 进度循环  */
/* ========================================= */
var progressState = {
  target: 0,
  shown: 0,
  raf: null,
  running: false,
  text: ''
};

function startProgressLoop() {
  if(progressState.running) return;
  progressState.running = true;
  
  function tick() {
    if(!progressState.running) return;
    
    var diff = progressState.target - progressState.shown;
    if(Math.abs(diff) < 0.5) progressState.shown = progressState.target;
    else progressState.shown += diff * 0.15;
    
    document.getElementById('overlayProgressFill').style.width = progressState.shown.toFixed(1) + '%';
    document.getElementById('overlayPercent').textContent = Math.round(progressState.shown) + '%';
    if(progressState.text) document.getElementById('overlayText').innerHTML = progressState.text;
    
    progressState.raf = requestAnimationFrame(tick);
  }
  progressState.raf = requestAnimationFrame(tick);
}

function stopProgressLoop() {
  progressState.running = false;
  if(progressState.raf) cancelAnimationFrame(progressState.raf);
}

function updateProgressUI(targetPct, textStr) {
  progressState.target = Math.max(0, Math.min(100, targetPct));
  progressState.text = textStr;
}

function enterPerformanceMode(titleText) {
  // 隐藏所有应用容器与导航，把 DOM 负载降到最低
  document.querySelector('.top-nav').style.display = 'none';
  document.getElementById('app-delay').style.display = 'none';
  document.getElementById('app-matting').style.display = 'none';
  
  // 激活遮罩与独立进度循环
  document.getElementById('genOverlay').classList.add('active');
  progressState.target = 0;
  progressState.shown = 0;
  progressState.text = titleText || '正在初始化...';
  startProgressLoop();
}

function exitPerformanceMode() {
  stopProgressLoop();
  document.querySelector('.top-nav').style.display = 'grid';
  var isDelay = document.getElementById('btn-mode-delay').classList.contains('active');
  document.getElementById('app-delay').style.display = isDelay ? 'block' : 'none';
  document.getElementById('app-matting').style.display = isDelay ? 'none' : 'block';
  document.getElementById('genOverlay').classList.remove('active');
}
</script>

