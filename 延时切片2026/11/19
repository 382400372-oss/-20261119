  function renderDisplay(){
    if(!state.dctx) return;
    var W = state.W, H = state.H;
    if(W === 0 || H === 0) return;
    var dctx = state.dctx;
    var tctx = state.tempCtx;
    var previewVideo = document.getElementById('mt_hidden_video');

    dctx.clearRect(0, 0, W, H);
    try { dctx.drawImage(previewVideo, 0, 0, W, H); } catch(e){}

    tctx.clearRect(0, 0, W, H);
    tctx.globalCompositeOperation = 'source-over';
    tctx.fillStyle = 'rgba(255, 70, 70, 0.5)';
    tctx.fillRect(0, 0, W, H);
    tctx.globalCompositeOperation = 'destination-in';
    tctx.drawImage(state.maskCanvas, 0, 0, W, H);
    tctx.globalCompositeOperation = 'source-over';

    dctx.drawImage(state.tempCanvas, 0, 0);

    if(state.toolMode === 'polygon' && state.polygonPoints.length > 0){
      dctx.save();
      dctx.strokeStyle = '#ff5050';
      dctx.lineWidth = 3;
      dctx.setLineDash([8, 6]);
      dctx.beginPath();
      for(var i=0;i<state.polygonPoints.length;i++){
        var p = state.polygonPoints[i];
        if(i===0) dctx.moveTo(p.x, p.y);
        else dctx.lineTo(p.x, p.y);
      }
      dctx.stroke();
      dctx.setLineDash([]);
      if(state.polygonPoints.length >= 3){
        dctx.beginPath();
        var p0 = state.polygonPoints[0];
        var pn = state.polygonPoints[state.polygonPoints.length-1];
        dctx.moveTo(pn.x, pn.y);
        dctx.lineTo(p0.x, p0.y);
        dctx.stroke();
      }
      for(var j=0;j<state.polygonPoints.length;j++){
        var pp = state.polygonPoints[j];
        dctx.beginPath();
        dctx.arc(pp.x, pp.y, 7, 0, Math.PI * 2);
        dctx.fillStyle = '#ff5050';
        dctx.fill();
        dctx.strokeStyle = '#ffffff';
        dctx.lineWidth = 2;
        dctx.stroke();
      }
      dctx.restore();
    }

    dctx.strokeStyle = 'rgba(0,113,227,0.3)';
    dctx.lineWidth = 2;
    dctx.strokeRect(1, 1, W-2, H-2);
  }

  function pushHistory(){
    try {
      var imgData = state.maskCtx.getImageData(0, 0, state.refW, state.refH);
      state.history.push(imgData);
      if(state.history.length > state.MAX_HISTORY) state.history.shift();
