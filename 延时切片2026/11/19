$ErrorActionPreference = 'Stop'
$desktop = [Environment]::GetFolderPath('Desktop')
if(-not $desktop){ $desktop = "$env:USERPROFILE\Desktop" }

Write-Host "正在下载核心依赖 Mp4Muxer..." -ForegroundColor Yellow
$muxerUrl = "https://cdn.jsdelivr.net/npm/mp4-muxer@5.1.3/build/mp4-muxer.min.js"
try {
    $muxerJs = (Invoke-WebRequest -Uri $muxerUrl -UseBasicParsing).Content
} catch {
    Write-Host "网络请求失败，请检查网络。按任意键退出。" -ForegroundColor Red
    $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
    exit 1
}

Write-Host "正在生成 延时切片v2026.11.19 单文件版..." -ForegroundColor Green
$htmlPath = Join-Path $desktop '延时切片v2026.11.19.html'

