  async function loadPreviewVideo(index){
    status2.innerHTML = '<span class="spinner"></span> 加载视频 ' + (index+1) + '/' + state.videoFiles.length + '…';

    var previewVideo = document.getElementById('mt_hidden_video');
    try { previewVideo.pause(); } catch(e){}

    var file = state.videoFiles[index];
    var url = URL.createObjectURL(file);
    previewVideo.src = url;

    await new Promise(function(res){
      var ok = false;
      function onCanPlay(){
        if(ok) return;
        ok = true;
        previewVideo.removeEventListener('canplay', onCanPlay);
        res();
      }
      previewVideo.addEventListener('canplay', onCanPlay);
      previewVideo.addEventListener('error', function(){
        if(ok) return;
        ok = true;
        res();
      });
      setTimeout(function(){ if(!ok){ ok = true; res(); } }, 8000);
    });

    state.previewIndex = index;
    state.W = previewVideo.videoWidth;
    state.H = previewVideo.videoHeight;
    state.duration = previewVideo.duration;

    if(state.refW === null){
      state.refW = state.W;
      state.refH = state.H;
      state.maskCanvas = document.createElement('canvas');
      state.maskCanvas.width = state.refW;
      state.maskCanvas.height = state.refH;
      state.maskCtx = state.maskCanvas.getContext('2d');
      state.history = [];
      state.polygonPoints = [];
      updateUndoBtn();
    }

    displayCanvas.width = state.W;
    displayCanvas.height = state.H;
    state.dctx = displayCanvas.getContext('2d');

    state.tempCanvas = document.createElement('canvas');
    state.tempCanvas.width = state.W;
    state.tempCanvas.height = state.H;
    state.tempCtx = state.tempCanvas.getContext('2d');

    timeline.min = 0;
    timeline.max = state.duration;
    timeline.step = 0.01;
    timeline.value = 0;
    totalTimeEl.textContent = formatTime(state.duration);
    currentTimeEl.textContent = formatTime(0);

    await waitSeek(previewVideo, 0);

    if(state.W === 0 || state.H === 0){
      state.W = previewVideo.videoWidth;
      state.H = previewVideo.videoHeight;
      displayCanvas.width = state.W;
      displayCanvas.height = state.H;
      state.tempCanvas.width = state.W;
      state.tempCanvas.height = state.H;
    }

    renderDisplay();
    status2.textContent = '用画笔在画面上刷出要保留的区域。尺寸：' + state.W + '×' + state.H;
    status2.style.color = 'var(--text-main)';
    updatePolygonActions();
    
    updateSummary();
  }

  var seekTarget = null;
  var isSeeking = false;

  async function seekLoop(){
    if(isSeeking) return;
    isSeeking = true;
    var previewVideo = document.getElementById('mt_hidden_video');
    while(seekTarget !== null){
      var t = seekTarget;
      seekTarget = null;
      await waitSeek(previewVideo, t);
      renderDisplay();
    }
    isSeeking = false;
  }

